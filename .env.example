# Copy this file to .env and fill in real values for local dev.
# Never commit a real .env file — see .gitignore.

ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Host ports published by docker-compose.yml ---
# Only the API and the console are published; Postgres and Redis stay on the
# compose network. Override these if something on your machine already binds
# the defaults (the README's URLs assume 8000 and 5173).
API_PORT=8000
CONSOLE_PORT=5173

# --- Database ---
DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegis

# --- CORS: comma-separated list of allowed browser origins.
#     Must not be "*" in production (enforced at startup).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Queue (see docker-compose.yml and app/services/queue.py) ---
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=memory
QUEUE_CONSUMER_GROUP=aegis-normalizers
QUEUE_CONSUMER_NAME=worker-1

# Ingestion mode:
#   inline — the ingest request normalizes and detects in-process (default;
#            deterministic, fine for dev and single-node installs)
#   worker — the request only enqueues; run `python -m app.worker` to drain
INGEST_MODE=inline

# --- Auth ---
# In production this MUST be changed and at least 32 characters, or the
# application refuses to start (see app/core/config.py::validate_runtime).
JWT_SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate limiting ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- SLA timers (minutes), by alert/case severity ---
SLA_MINUTES_CRITICAL=60
SLA_MINUTES_HIGH=240
SLA_MINUTES_MEDIUM=1440
SLA_MINUTES_LOW=4320

# --- Background scheduler (SLA breach sweeps, threat-intel feed polls).
#     Run this in exactly ONE replica when scaling horizontally.
SCHEDULER_ENABLED=true
SLA_SWEEP_INTERVAL_SECONDS=60
THREAT_INTEL_POLL_INTERVAL_SECONDS=3600

# --- Notifications ---
# Channels are configured in the database (Settings -> Notifications).
# These are fallbacks used when a channel supplies no URL of its own.
NOTIFICATIONS_ENABLED=true
NOTIFY_MIN_SEVERITY=medium
NOTIFY_WEBHOOK_URL=
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_HTTP_TIMEOUT_SECONDS=5

# SMTP, for email notification channels.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=aegis@example.com
SMTP_TO=
SMTP_USE_TLS=true

# --- Detection engine ---
# Incremental evaluation reads events newer than (watermark - lookback), so a
# threshold window spanning a batch boundary still fires.
RULE_EVAL_LOOKBACK_SECONDS=3600
RULE_EVAL_MAX_EVENTS=50000

# --- API pagination ---
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
